# Optional VoltWise local overrides.
# The supported start-voltwise.bat launcher sets the required local paths and
# works without an .env file. VoltWise reads process environment variables; it
# does not automatically load this file. Copy values into your shell or runtime
# configuration if you need to override defaults.

VOLTWISE_MODE=SIMULATION
VOLTWISE_DB_PATH=data/voltwise.db
VOLTWISE_ENERGY_SCENARIO=NORMAL_CURRENT_CYCLE
VOLTWISE_HEATER_FAULT=NONE
VOLTWISE_MCP_HOST=127.0.0.1
VOLTWISE_MCP_PORT=8001
VOLTWISE_MCP_PATH=/mcp
VOLTWISE_MCP_URL=http://127.0.0.1:8001/mcp
VOLTWISE_CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173

# Leave secrets unset for the localhost-only demo. Inject real values through
# the deployment environment; never commit them.
# VOLTWISE_MCP_BEARER_TOKEN=
# VOLTWISE_DEMO_USERNAME=
# VOLTWISE_DEMO_PASSWORD=
